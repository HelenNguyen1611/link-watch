{
	"name": "linkwatch",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @linkwatch/web dev",
		"build": "pnpm -r build",
		"test": "vitest run --project unit",
		"test:int": "vitest run --project int --passWithNoTests",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "pnpm -r exec tsc --noEmit",
		"synth": "pnpm --filter @linkwatch/infra exec cdk synth",
		"deploy": "pnpm --filter @linkwatch/infra exec cdk deploy --all",
		"db:local": "docker run -d --name linkwatch-ddb -p 8000:8000 amazon/dynamodb-local",
		"db:init": "tsx packages/core/scripts/create-local-table.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/aws-lambda": "^8.10.163",
		"@types/node": "^26.6.3",
		"aws-sdk-client-mock": "^4.1.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	}
}
